# ============================================================
# LLM Gateway — example environment
# ============================================================
# Copy to `.env` (or export inline). The gateway reads variables with
# the GATEWAY_ prefix (pydantic-settings); OpenTelemetry variables use
# the standard OTEL_ names and are read by the OTel SDK itself.
# Provider credentials (below) are resolved by the api_key_env names
# in config.yaml. On startup the whole file is also exported into the
# process environment — real environment variables always win.

# --- Gateway core ------------------------------------------------------

# Admin key for the /admin/* API (required to manage keys, view logs, ...)
GATEWAY_ADMIN_KEY=sk-gw-change-me

# SQLite by default; swap for PostgreSQL without code changes:
#   postgresql+asyncpg://user:pass@host:5432/llm_gateway
GATEWAY_DATABASE_URL=sqlite+aiosqlite:///./gateway.db

# Path to the providers/models/guardrails YAML
GATEWAY_CONFIG_PATH=./config.yaml

# Where POST /admin/backup writes SQLite snapshots (VACUUM INTO —
# consistent copies of the live database; restore = stop, swap the file,
# start). Created on first backup.
GATEWAY_BACKUP_DIR=./backups

# --- Logging -----------------------------------------------------------

GATEWAY_LOG_LEVEL=INFO
# "text" (default) or "json" — single-line JSON records on stdout,
# friendly to Loki/Elastic/any JSON ingester
GATEWAY_LOG_FORMAT=text

# --- OpenTelemetry -----------------------------------------------------

# true installs the global TracerProvider: gateway.chat spans, the OTel
# logs pipeline (records carry the active span's trace context) and the
# Prometheus->OTel metrics bridge (see endpoint notes below).
# false (default) keeps the OTel API a no-op.
GATEWAY_OTEL_ENABLED=false

OTEL_SERVICE_NAME=llm-gateway

# OTLP endpoints (HTTP). Set the generic endpoint to enable all three
# pipelines at once, or set per-signal endpoints to pick individually:
#   OTEL_EXPORTER_OTLP_TRACES_ENDPOINT   -> spans   (e.g. a collector, Jaeger)
#   OTEL_EXPORTER_OTLP_LOGS_ENDPOINT     -> OTel log records (collector -> Loki)
#   OTEL_EXPORTER_OTLP_METRICS_ENDPOINT  -> starts the Prometheus->OTel bridge
# Note: with only the generic endpoint set, the metrics bridge also runs;
# per-signal control is the way to keep Prometheus scraping as the only
# metrics path.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
#OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs
#OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics

# Head-based sampling, resolved by the gateway at startup:
#   always_on | always_off | traceidratio |
#   parentbased_always_on | parentbased_always_off | parentbased_traceidratio
# (Tail-based sampling — keep errors/slow traces — belongs to the collector:
# see deploy/otel-collector/config.yaml.)
#OTEL_TRACES_SAMPLER=traceidratio
#OTEL_TRACES_SAMPLER_ARG=0.1

# Batch span processor tuning (defaults shown; values in ms / counts)
#OTEL_BSP_SCHEDULE_DELAY=5000
#OTEL_BSP_MAX_QUEUE_SIZE=2048
#OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512
#OTEL_BSP_EXPORT_TIMEOUT=30000

# --- Provider credentials (referenced from config.yaml api_key_env) ----

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Redis (multi-worker / multi-replica deployments) ------------------
# Referenced from config.yaml via redis.url_env; only needed when
# rate_limit.backend / cache.backend is "redis".
#REDIS_URL=redis://localhost:6379/0

# --- Budget alert webhook ----------------------------------------------
# Referenced from config.yaml via alerts.url_env; POST target for
# budget-threshold alerts (e.g. a Slack incoming webhook). Without it,
# crossings are only counted on gateway_alerts_total{outcome="skipped"}.
#ALERT_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX
